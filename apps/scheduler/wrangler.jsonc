{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agency-dashboard-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // ŠTYRI cron triggery (limit je 5 na účet — Workers Free). Workers Free dáva
  // 10 ms CPU a 50 subrequestov na JEDNO spustenie, preto sa uptime delí na
  // dávky do troch cronov: */5 = monitor (uptime lane 0, job health, alerty),
  // 1-59/5 = uptime lane 1 + alerty, 2-59/5 = údržba (domény, wp-cron, e-mail
  // health), 3-59/5 = uptime lane 2 + alerty. Výrazy musia sedieť s *_CRON v src/index.ts.
  "triggers": { "crons": ["*/5 * * * *", "1-59/5 * * * *", "2-59/5 * * * *", "3-59/5 * * * *"] }
}
