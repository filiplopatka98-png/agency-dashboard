{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agency-dashboard-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // DVA cron triggery (limit je 5 na účet): Workers Free dáva 10 ms CPU a 50
  // subrequestov na JEDNO spustenie, celý tick sa do toho nezmestil. */5 =
  // monitor (uptime, job health, alerty), 2-59/5 = údržba (domény, wp-cron,
  // e-mail health). Výrazy musia sedieť s MONITOR_CRON/UPKEEP_CRON v src/index.ts.
  "triggers": { "crons": ["*/5 * * * *", "2-59/5 * * * *"] }
}
